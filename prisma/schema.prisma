generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HomeComponent {
  id                String             @id @default(cuid())
  name              String
  typeKey           String
  buildYear         Int
  customCostChf            Float?
  customLifetimeYrs        Int?
  plannedRenovationYear    Int?
  plannedRenovationCostChf Float?
  notes                    String?
  renovationPlanned        Boolean            @default(true)
  maintenanceIntervalMonths Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  maintenance       MaintenanceEntry[]
  documents         Document[]
  costs             Cost[]
  houseDocuments    HouseDocument[]
}

model MaintenanceEntry {
  id              String        @id @default(cuid())
  componentId     String
  component       HomeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  date            DateTime
  description     String
  costChf         Float?
  serviceProvider String?
  createdAt       DateTime      @default(now())
}

model Document {
  id          String        @id @default(cuid())
  componentId String
  component   HomeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  filename    String
  storedName  String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime      @default(now())
}

model Setting {
  key   String @id
  value String
}

model Cost {
  id          String         @id @default(cuid())
  type        String         // 'einmalig' | 'wiederkehrend'
  category    String         // 'reparatur' | 'versicherung' | 'heizung_service' | 'garten' | 'reinigung' | 'verwaltung' | 'sonstiges'
  description String
  amountChf   Float
  date        DateTime
  recurrence  String?        // null | 'monatlich' | 'vierteljährlich' | 'jährlich'
  componentId String?
  component   HomeComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model HouseDocument {
  id          String         @id @default(cuid())
  category    String         // 'grundbuch' | 'versicherung' | 'bauplan' | 'hypothek' | 'energie' | 'behoerden' | 'wartung' | 'sonstiges'
  title       String
  description String?
  filename    String?        // null if external link
  storedName  String?        // null if external link
  externalUrl String?        // null if uploaded file
  componentId String?
  component   HomeComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Link {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GardenPlant {
  id                   String        @id @default(cuid())
  name                 String
  latinName            String?
  typeKey              String
  locationHint         String?
  posX                 Float?
  posY                 Float?
  plantedYear          Int?
  status               String        @default("gut")
  winterProtection     Boolean       @default(false)
  wateringIntervalDays Int?
  fertilizingWeeks     Int?
  pruningMonths        String?
  notes                String?
  photos               GardenPhoto[]
  todos                GardenTodo[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model GardenElement {
  id        String        @id @default(cuid())
  name      String
  typeKey   String
  posX      Float?
  posY      Float?
  sizeM2    Float?
  notes     String?
  photos    GardenPhoto[]
  todos     GardenTodo[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GardenPhoto {
  id         String         @id @default(cuid())
  storedName String
  filename   String
  mimeType   String
  sizeBytes  Int
  notes      String?
  plantId    String?
  plant      GardenPlant?   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  elementId  String?
  element    GardenElement? @relation(fields: [elementId], references: [id], onDelete: Cascade)
  uploadedAt DateTime       @default(now())
}

model GardenTodo {
  id          String         @id @default(cuid())
  title       String
  description String?
  dueMonth    Int?
  recurring   Boolean        @default(false)
  done        Boolean        @default(false)
  doneAt      DateTime?
  priority    String         @default("normal")
  category    String         @default("pflege")
  plantId     String?
  plant       GardenPlant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
  elementId   String?
  element     GardenElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
