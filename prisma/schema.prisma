generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HomeComponent {
  id                String             @id @default(cuid())
  name              String
  typeKey           String
  buildYear         Int
  customCostChf            Float?
  customLifetimeYrs        Int?
  plannedRenovationYear    Int?
  plannedRenovationCostChf Float?
  notes                    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  maintenance       MaintenanceEntry[]
  documents         Document[]
}

model MaintenanceEntry {
  id              String        @id @default(cuid())
  componentId     String
  component       HomeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  date            DateTime
  description     String
  costChf         Float?
  serviceProvider String?
  createdAt       DateTime      @default(now())
}

model Document {
  id          String        @id @default(cuid())
  componentId String
  component   HomeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  filename    String
  storedName  String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime      @default(now())
}

model Setting {
  key   String @id
  value String
}
