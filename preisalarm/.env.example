# Database (dev: local file, production: overridden by Docker)
DATABASE_URL="file:./prisma/dev.db"

# Claude AI for price extraction fallback (optional — can also set via UI)
CLAUDE_API_KEY=sk-ant-...

# SMTP for email notifications (optional — can also set via Settings UI)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=587
SMTP_USER=deine@email.ch
SMTP_PASS=dein-app-passwort
SMTP_FROM=Preisalarm <deine@email.ch>
NOTIFY_EMAIL=deine@email.ch

# Telegram Bot (optional — can also set via Settings UI)
TELEGRAM_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Playwright (for Docker — uses system Chromium)
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
