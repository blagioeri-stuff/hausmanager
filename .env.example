# Datenbank (SQLite)
DATABASE_URL="file:./prisma/dev.db?connection_limit=1&socket_timeout=15"

# Datei-Upload-Verzeichnis (optional, Standard: ./public/uploads)
# UPLOAD_DIR="/app/uploads"

# Claude API Key (optional) — hat Vorrang vor dem in den Einstellungen gespeicherten Key
# Empfohlen für Docker/NAS-Deployments: Key hier setzen statt im Browser eingeben
# CLAUDE_API_KEY=sk-ant-...

# Backup-Verzeichnis (optional, Standard: ./data/backups)
# BACKUP_DIR="/data/backups"
