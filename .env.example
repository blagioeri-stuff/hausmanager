# =============================================================================
# Hausmanager — Environment-Variablen
# =============================================================================
# Lokale Entwicklung: Datei nach .env kopieren und Werte eintragen.
# NAS-Deployment: separate .env neben docker-compose.yml anlegen (chmod 600).

# --- Datenbank ---------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db?connection_limit=1&socket_timeout=15"

# --- Upload-Verzeichnis (optional) ------------------------------------------
# Standard lokal: ./public/uploads
# Im Docker-Container wird automatisch /app/uploads gesetzt (siehe compose).
# UPLOAD_DIR="/app/uploads"

# --- Backup-Verzeichnis (optional) ------------------------------------------
# BACKUP_DIR="/app/data/backups"

# --- Claude API Key (optional) ----------------------------------------------
# Hat Vorrang vor dem in den Einstellungen gespeicherten Key.
# Empfohlen für Docker/NAS-Deployments: Key hier setzen statt im Browser eingeben.
# CLAUDE_API_KEY=sk-ant-...

# --- Authentifizierung (Pflicht in Produktion!) -----------------------------
# Beide Werte mit folgendem Skript erzeugen:
#   node scripts/hash-password.mjs "DEIN-PASSWORT"
# APP_PASSWORD_HASH="scrypt$<saltHex>$<keyHex>"
# SESSION_SECRET="<32+ Bytes Hex>"
# Lebensdauer der Login-Session in Sekunden (Standard: 30 Tage)
# SESSION_MAX_AGE=2592000

# --- Cloudflare Tunnel (nur NAS) --------------------------------------------
# Token aus dem Cloudflare-Dashboard (Networks → Tunnels → Connector cloudflared).
# TUNNEL_TOKEN="eyJhIjoi..."
